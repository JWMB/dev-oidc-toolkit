@page "/users"
@model UsersPageModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Users";
}

<a href="/">Return to homepage</a>

<h1>Users</h1>

@if (Model.Users.Any())
{
    <ul class="user-list">
		@foreach (var user in Model.Users)
        {
            <li style="list-style: none;">
                <details>
                    <summary class="email">@user.Email</summary>
                    @{
                        var options = new JsonSerializerOptions { WriteIndented = true };
                        var json = JsonSerializer.Serialize(user, options);
                    }
					<a href="/users?email=@user.Email">Edit</a>
					<pre class="raw-data">@Html.Raw(json)</pre>
                </details>
            </li>
        }
    </ul>
}
else
{
    <p>No users found</p>
}

<form method="post">
	<textarea asp-for="JsonInput"></textarea>
	<input type="submit" asp-page-handler="SubmitJson" value=@(Model.Input == null ? "Create" : "Modify")>
</form>

<form method="post">
	@if (!ViewData.ModelState.IsValid)
	{
		<div>
			@Html.Raw(FormGenerator.RenderValidationErrors(ViewData.ModelState))
			@Html.ValidationSummary()
		</div>
	}

	@Html.Raw(Model.GetFormHtml())

	<input type="submit" value=@(Model.Input == null ? "Create" : "Modify")>
</form>
