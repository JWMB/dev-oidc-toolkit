@page "/users"
@model UsersPageModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "Users";
}

<a href="/">Return to homepage</a>

<h1>Users</h1>

@if (Model.Users.Any())
{
    <ul class="user-list">
		@foreach (var user in Model.Users)
        {
            <li style="list-style: none;">
                <details>
                    <summary class="email">@user.Email</summary>
                    @{
                        var options = new JsonSerializerOptions { WriteIndented = true };
                        var json = JsonSerializer.Serialize(user, options);
                    }
					<a href="/users?email=@user.Email">Edit</a>
					<pre class="raw-data">@Html.Raw(json)</pre>
                </details>
            </li>
        }
    </ul>
}
else
{
    <p>No users found</p>
}
<form method="post">
	@if (!ViewData.ModelState.IsValid)
	{
		<div>
			@Html.ValidationSummary()
		</div>
	}

	@foreach (var pEx in Model.UserProperties)
	{
		object? value = null;
		if (Model.Input != null)
		{
			value = pEx.PropertyInfo.GetValue(Model.Input); //?.ToString();
		}
		if (value == null && pEx.IsRequired && pEx.DefaultValue != null)
		{
			value = pEx.DefaultValue;
		}
		var strValue = value?.ToString();
		var p = pEx.PropertyInfo;
		<label for=@p.Name>@(pEx.IsRequired ? "* " : "")@p.Name</label>
		@if (p.PropertyType == typeof(bool))
		{
			// Html.CheckBoxFor(m => (bool?)value == true, new { name = p.Name }); // Templates can be used only with field access,
			// <input type="checkbox" name=@p.Name checked=@(strValue?.ToLower() == "true" ? "checked" : "") /> *@
			if ((bool?)value == true)
			{
				<input type="checkbox" name=@p.Name checked />
			}
			else
			{
				<input type="checkbox" name=@p.Name />
			}
		}
		else if (p.PropertyType == typeof(string))
		{
			<input type="text" name=@p.Name value=@strValue />
		}
		else if (new[] { typeof(long), typeof(ulong), typeof(int), typeof(uint), typeof(short), typeof(ushort), typeof(byte) }.Contains(pEx.Type))
		{
			<input type="number" name=@p.Name value=@strValue />
		}
		else if (new[] { typeof(DateTimeOffset), typeof(DateTime) }.Contains(pEx.Type))
		{
			<input type="date" name=@p.Name value=@strValue />
		}
		else
		{
			<div>@p.PropertyType.Name @string.Join(", ", p.PropertyType.GenericTypeArguments.Select(o => o.Name))</div>
		}

		@* switch (p.PropertyType.Name)
		{
			default: <input type="text" name=@p.Name />
		}
		p.PropertyType switch
		{
		_ => <input type= "text" name= @p.Name />
		}*@

 	}
	<input type="submit" value=@(Model.Input == null ? "Create" : "Modify")>
</form>