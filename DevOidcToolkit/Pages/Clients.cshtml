@page "/clients"
@model ClientsPageModel
@using System.Text.Json
@{
    Layout = "_Layout";
    ViewData["Title"] = "clients";
}

<a href="/">Return to homepage</a>

<h1>Clients</h1>

@if (Model.Clients.Any() == true)
{
    <ul class="client-list">
		@foreach (var client in Model.Clients)
        {
            <li style="list-style: none;">
                <details>
                    <summary class="name">@client.ClientId</summary>
                    @{
                        var options = new JsonSerializerOptions { WriteIndented = true };
                        var json = JsonSerializer.Serialize(client, options);
					}
					<a href="/clients?clientid=@client.ClientId">Edit</a>
                    <pre class="raw-data">@Html.Raw(json)</pre>
                </details>
            </li>
        }
    </ul>
}
else
{
    <p>No clients found</p>
}

<form method="post">
	<textarea asp-for="JsonInput"></textarea>
	<input type="submit" asp-page-handler="SubmitJson" value=@(Model.Input == null ? "Create" : "Modify")>
</form>

<form method="post">
	@if (!ViewData.ModelState.IsValid)
	{
		<div>
			@Html.ValidationSummary()
		</div>
	}

	@Html.Raw(FormGenerator.Render(Model.Input, Model.GetRenderOverrides()))

	<input type="submit" value=@(Model.Input == null ? "Create" : "Modify")>
</form>