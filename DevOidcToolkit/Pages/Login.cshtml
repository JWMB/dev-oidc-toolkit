@page "/login"
@model DevOidcToolkit.Pages.LoginPageModel

@{
    ViewData["Title"] = "Log In";
    Layout = "_Layout";
}

<h1>Log In</h1>

@if (Model.IsDevelopment)
{
<form id="login" method="post">
    @if (!ViewData.ModelState.IsValid)
    {
        <div>
            @Html.ValidationSummary()
        </div>
    }

	<label for="email">Select User</label>
	<select asp-for="Input.Email" asp-items="Model.UserEmails" id="email">
		<option value="">-- Select User Email --</option>
	</select>
	<span asp-validation-for="Input.Email"></span>

	<label for="remember-me">
		<input asp-for="Input.RememberMe" type="checkbox" id="remember-me" />
		Remember me
	</label>

	<button type="submit">Log In</button>
</form>
}
else
{
<form id="loginWithPassword" method="post">
	@if (!ViewData.ModelState.IsValid)
	{
		<div>
			@Html.ValidationSummary()
		</div>
	}

	<label for="email">Email or username</label>
		<input asp-for="Credentials.EmailOrUsername" id="email">

	<label for="password">Password</label>
		<input asp-for="Credentials.Password" id="password" type="password" />

		
	<button type="submit" asp-page-handler="Password">Log In</button>
</form>
}